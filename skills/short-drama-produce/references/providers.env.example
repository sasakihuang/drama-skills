# Drama Skills 供应商凭据（每个人填自己的 Key）
#
# 放在：用户主目录/.drama-skills/providers.env
# 不要放进短剧项目文件夹，不要提交到 git，不要把 Key 发到对话里。
# 已经在系统环境变量里设置过的同名项，以环境变量为准。
# 格式：一行一个 名字=值，# 开头的是注释。

# ---- MiniMax：视频（H3 / Hailuo）和配音 ----
# 订阅套餐的 Key 一般是 sk-cp- 开头；按量付费的 Key 会直接扣账户余额。
MINIMAX_API_KEY=
# 国内站账号填 cn，国际站（minimax.io）账号填 global
MINIMAX_REGION=cn
# 视频右下角的「AI 生成」标识，默认开；国内发布要求标明 AI 生成，建议不要关
# MINIMAX_AIGC_WATERMARK=true

# ---- 画图：GPT Image 2，走 yoyo 中转 ----
# Key 在 yoyo 后台自己生成
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.yoyochatai.com/v1
